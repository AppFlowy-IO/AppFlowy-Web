{
  "manifest_version": 3,
  "name": "AppFlowy YouTube transcript helper",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Let AppFlowy download YouTube audio on your device for transcription.",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://beta.appflowy.cloud/*",
    "https://test.appflowy.cloud/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://beta.appflowy.cloud/*", "https://test.appflowy.cloud/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["marker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://beta.appflowy.cloud/*", "https://test.appflowy.cloud/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["playback-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["playback-content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "youtube_audio", "enabled": true, "path": "rules.json" }]
  }
}
