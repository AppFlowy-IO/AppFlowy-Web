      "end": "2024-06-30"
    },
    {
      "name": "this ignores the amount",
      "today": "2024-06-12",
      "spec": {"relative_direction": "this", "relative_amount": 5, "relative_unit": "year"},
      "start": "2024-01-01",
      "end": "2024-12-31"
    }
  ],
  "matches": [
