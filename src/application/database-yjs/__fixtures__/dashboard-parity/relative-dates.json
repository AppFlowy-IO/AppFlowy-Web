{
  "fixture": "relative-dates",
  "version": 1,
  "encoding": {
    "spec": "The content of a DateStartsRelative (28) / DateEndsRelative (29) filter. Readers default an unknown or missing direction to this, a missing or non-numeric amount to 1 (numbers are floored and clamped to 1..9999), and an unknown or missing unit to week.",
    "ranges": "relativeDateRange(spec, today) as inclusive local dates [start, end]. Weeks run Monday..Sunday; months and years shift by calendar months, clamping the day to the month's length.",
    "matches": "Whether a date cell passes the filter on `today`. 28 compares the start date; 29 compares the end date, or the start date when the cell has no end. Dates are local dates; null is no date."
  },
  "ranges": [
    {
      "name": "past 7 days",
      "today": "2024-06-12",
      "spec": {"relative_direction": "past", "relative_amount": 7, "relative_unit": "day"},
      "start": "2024-06-05",
      "end": "2024-06-12"
    },
    {
      "name": "next 2 weeks",
      "today": "2024-06-12",
      "spec": {"relative_direction": "next", "relative_amount": 2, "relative_unit": "week"},
      "start": "2024-06-12",
      "end": "2024-06-26"
    },
    {
      "name": "this week",
      "today": "2024-06-12",
      "spec": {"relative_direction": "this", "relative_amount": 1, "relative_unit": "week"},
      "start": "2024-06-10",
      "end": "2024-06-16"
    },
    {
      "name": "this week on a Sunday",
      "today": "2024-06-16",
