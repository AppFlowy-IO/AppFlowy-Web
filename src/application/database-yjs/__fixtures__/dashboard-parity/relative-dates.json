      "end": "2024-06-30"
    },
    {
      "name": "this month in a leap February",
      "today": "2024-02-10",
      "spec": {"relative_direction": "this", "relative_amount": 1, "relative_unit": "month"},
      "start": "2024-02-01",
      "end": "2024-02-29"
    },
    {
      "name": "this year",
      "today": "2024-06-12",
