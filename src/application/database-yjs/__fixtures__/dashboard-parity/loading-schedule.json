        "hostSourceId": "host",
        "closed": false,
        "visibleStartedAt": null,
        "sourceRows": {},
        "widgets": [
          { "id": "w1", "sourceId": "A", "visible": true, "state": "idle", "firstData": false },
          { "id": "w2", "sourceId": "B", "visible": false, "state": "idle", "firstData": false },
          { "id": "w3", "sourceId": "A", "visible": false, "state": "idle", "firstData": false }
        ]
      },
      "expected": { "start": ["w1"], "nextWakeAt": 11000 }
    },
