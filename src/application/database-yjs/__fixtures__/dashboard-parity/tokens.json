      "resolved": { "light": "#FFFFFF", "dark": "#21232A", "desktopDark": "#1A202C" },
      "use": "Card background: always the page background, so a dark card is ring-only"
    },
    "cardRing": {
      "kind": "literal",
      "light": "rgba(31,35,41,0.08)",
      "dark": "rgba(255,255,255,0.08)",
      "notion": { "light": "rgba(42,28,0,0.07)", "dark": "rgba(255,255,243,0.082)" },
      "resolved": { "light": "#1F232914", "dark": "#FFFFFF14" },
      "use": "1px card ring in View mode, drawn as a box-shadow ring, never a CSS border"
    },
    "title": {
      "kind": "ref",
      "ref": "text-secondary",
      "notion": { "light": "#7D7A75", "dark": "#ADA9A3" },
      "resolved": { "light": "#6F748C", "dark": "#989EB7" },
      "use": "Widget title in View mode"
    },
    "toolIcon": {
      "kind": "literal",
      "light": "#6F748C",
      "dark": "#B5BBD3",
