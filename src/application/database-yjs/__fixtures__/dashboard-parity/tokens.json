{
  "schema": "appflowy.dashboard-parity.tokens",
  "version": 1,
  "principle": "Notion's measured alphas, sizes and radii; AppFlowy theme hues; the chart series palette is Notion's, verbatim.",
  "refRule": "A ref is a web semantic CSS variable name without the leading '--'. Desktop maps it mechanically: the first segment picks the AppFlowyTheme color scheme (fill, text, icon, border, surface, background) and the rest is camelCased, so fill-theme-thick is fillColorScheme.themeThick.",
  "color": {
    "accent": {
      "kind": "ref",
      "ref": "fill-theme-thick",
      "notion": { "light": "#2383E2", "dark": "#2383E2" },
      "resolved": { "light": "#00B5FF", "dark": "#00B5FF" },
      "use": "Done, drop line, resize bar while dragging, selection outline, selected chart type"
    },
    "editTitle": {
      "kind": "ref",
      "ref": "text-action",
      "notion": { "light": "#1567C0", "dark": "#2F7BD8" },
      "resolved": { "light": "#0092D6", "dark": "#00B5FF" },
      "use": "Widget title in Edit mode"
    },
    "editIcon": {
      "kind": "ref",
      "ref": "fill-theme-thick",
      "notion": { "light": "#1477DB", "dark": "#2F7BD8" },
      "resolved": { "light": "#00B5FF", "dark": "#00B5FF" },
      "use": "Edit-mode tool icons; an active filter or sort icon in any mode"
    },
    "editTint": {
      "kind": "alpha",
      "ref": "fill-theme-thick",
      "alpha": { "light": 0.06, "dark": 0.08 },
      "notion": { "light": "#F3F9FD", "dark": "#1A2129" },
      "resolved": { "light": "#00B5FF0F", "dark": "#00B5FF14" },
      "use": "Widget box fill in Edit mode"
    },
    "editRing": {
      "kind": "alpha",
      "ref": "fill-theme-thick",
      "alpha": { "light": 0.14, "dark": 0.25 },
      "notion": { "light": "#DFEEFA", "dark": null },
      "resolved": { "light": "#00B5FF24", "dark": "#00B5FF40" },
      "use": "Card ring in Edit mode"
    },
    "rowControlBg": {
      "kind": "ref",
      "ref": "fill-theme-select",
      "notion": { "light": "#E9F3FE", "dark": "#253A4F" },
      "resolved": { "light": "#00B5FF1A", "dark": "#00B5FF26" },
      "use": "Row arrows, row +, bottom +, + New view pill"
    },
    "cardBg": {
      "kind": "page",
      "web": "var(--background-primary)",
      "desktop": "Theme.of(context).scaffoldBackgroundColor",
