      "stored": {
        "rows": [
          { "id": "r:1", "height": "tall", "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": "wide", "zz_parity_probe": { "widget": "w:1" } }
