          ] }
        ]
      },
      "writtenKeys": ["rows"],
      "expected": {
        "rows": [
          { "id": "r:0", "height": 480, "zz_parity_probe": { "row": "r:0" }, "widgets": [
            { "id": "w:0:0", "view_id": "v:1", "database_id": "db:1", "width": 12, "zz_parity_probe": { "widget": "w:0:0" } }
          ] }
        ]
      }
    },
    {
