{
  "fixture": "layouts/unknown-keys",
  "version": 1,
  "encoding": {
    "bigint": "{\"$bigint\": \"<decimal>\"} is an integer written by a native client (yrs Any::BigInt). A plain JSON number is a JS number (Any::Number). Readers accept both, and every comparison is by numeric value.",
    "ignoreOnCompare": ["chartType", "xFieldId", "showEmptyValues", "aggregationType", "yFieldId", "dateCondition"],
    "stored": "The layout-settings map as another (newer) client left it.",
    "parsed": "Optional. The typed projection every client must read from stored, in the persisted snake_case shape.",
    "write": "The typed value this client submits for the named top-level keys, in the persisted shape. Each client parses it into its own typed model before writing.",
    "writtenKeys": "Exactly the top-level keys the write may touch, after removing ignoreOnCompare keys.",
    "expected": "The stored map after the write. Key order is irrelevant."
  },
  "dashboardCases": [
    {
      "name": "row, widget and top-level extras survive a width change",
      "stored": {
        "rows": [
          { "id": "r:1", "height": { "$bigint": "360" }, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": { "$bigint": "8" }, "zz_parity_probe": { "widget": "w:1" } },
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 4 }
          ] }
        ],
        "global_filters": [],
        "show_widget_titles": true,
        "zz_parity_probe": { "from": "newer-app", "version": 99, "list": ["a", "b"], "nested": { "flag": true } }
      },
      "write": {
        "rows": [
          { "id": "r:1", "height": 360, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 6 },
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 6 }
          ] }
        ]
      },
      "writtenKeys": ["rows"],
      "expected": {
        "rows": [
          { "id": "r:1", "height": 360, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 6, "zz_parity_probe": { "widget": "w:1" } },
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 6 }
          ] }
        ],
        "global_filters": [],
        "show_widget_titles": true,
        "zz_parity_probe": { "from": "newer-app", "version": 99, "list": ["a", "b"], "nested": { "flag": true } }
      }
    },
    {
      "name": "widget extras follow the widget into another row and rows keep theirs when reordered",
      "stored": {
        "rows": [
          { "id": "r:1", "height": 360, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 6, "zz_parity_probe": { "widget": "w:1" } },
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 6 }
          ] },
          { "id": "r:2", "height": 480, "zz_parity_probe": { "row": "r:2" }, "widgets": [
            { "id": "w:3", "view_id": "v:3", "database_id": "db:2", "width": 12, "zz_parity_probe": { "widget": "w:3" } }
          ] }
        ]
      },
      "write": {
        "rows": [
          { "id": "r:2", "height": 480, "widgets": [
            { "id": "w:3", "view_id": "v:3", "database_id": "db:2", "width": 6 },
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 6 }
          ] },
          { "id": "r:1", "height": 360, "widgets": [
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 12 }
          ] }
        ]
      },
      "writtenKeys": ["rows"],
      "expected": {
        "rows": [
          { "id": "r:2", "height": 480, "zz_parity_probe": { "row": "r:2" }, "widgets": [
            { "id": "w:3", "view_id": "v:3", "database_id": "db:2", "width": 6, "zz_parity_probe": { "widget": "w:3" } },
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 6, "zz_parity_probe": { "widget": "w:1" } }
          ] },
          { "id": "r:1", "height": 360, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 12 }
          ] }
        ]
      }
    },
