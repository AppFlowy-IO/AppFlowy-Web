        ],
        "global_filters": [
          { "id": "gf:1", "name": "Done", "ty": { "$bigint": "5" }, "condition": { "$bigint": "1" }, "content": "", "targets": { "db:1": "f:done" }, "target_order": ["db:1"], "zz_parity_probe": { "filter": "gf:1" } },
          { "id": "gf:2", "name": "Stage", "ty": 3, "condition": 0, "content": "opt:a", "targets": { "db:1": "f:stage" }, "target_order": ["db:1"], "zz_parity_probe": { "filter": "gf:2" } }
        ]
