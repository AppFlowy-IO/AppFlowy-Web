      "writtenKeys": ["rows"],
      "expected": {
        "rows": [
          { "id": "r:1", "height": 360, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 12 }
          ] },
          { "id": "r:9", "height": 360, "widgets": [
            { "id": "w:2", "view_id": "v:2", "database_id": "db:1", "width": 12, "zz_parity_probe": { "widget": "w:2" } }
          ] }
        ]
      }
    },
