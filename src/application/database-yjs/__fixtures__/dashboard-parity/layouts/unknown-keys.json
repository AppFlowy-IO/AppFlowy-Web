            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 12 }
          ] }
        ],
        "global_filters": [
          { "id": "gf:1", "name": "Done", "ty": 5, "condition": 0, "content": "", "targets": { "db:1": "f:done" }, "target_order": ["db:1"], "zz_parity_probe": { "filter": "gf:1" } },
          { "id": "gf:3", "name": "Urgent", "ty": 5, "condition": 0, "content": "", "targets": { "db:1": "f:urgent" }, "target_order": ["db:1"] }
        ]
      }
    },
