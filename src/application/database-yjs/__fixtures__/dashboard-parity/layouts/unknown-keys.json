      "write": {
        "rows": [
          { "id": "r:1", "height": 400, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 12 }
          ] }
        ]
      },
      "writtenKeys": ["rows"],
      "expected": {
        "rows": [
          { "id": "r:1", "height": 400, "zz_parity_probe": { "row": "r:1" }, "widgets": [
            { "id": "w:1", "view_id": "v:1", "database_id": "db:1", "width": 12, "zz_parity_probe": { "widget": "w:1" } }
          ] }
        ]
      }
    },
    {
      "name": "global filter extras survive a condition change; a new filter has none; a deleted filter's go",
      "stored": {
        "rows": [
          { "id": "r:1", "height": 360, "widgets": [
