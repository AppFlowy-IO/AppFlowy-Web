{
  "fixture": "series",
  "version": 1,
  "encoding": {
    "rows": "Rows in view order. x and sub hold the R-GROUPKEY keys the row maps to, already extracted (WP11); [] means no value and becomes __empty__. y is WP11's per-row Y value (number or null).",
    "xField": "kind (select | checkbox | other) and the X candidate groups in WP11's candidate order (auto, manual or label). __empty__ is last.",
    "subField": "null when there is no effective Group by. Otherwise kind and the sub-group candidates in auto order, __empty__ last.",
    "optionColor": "SelectOptionColor name from tokens.json (Purple, Pink, LightPink, Orange, Yellow, Lime, Green, Aqua, Blue, Cream, Mint, Sky, Lilac, Pearl, Sunset, Coral, Sapphire, Moss, Sand, Charcoal).",
    "colors": "#RRGGBB opaque; #RRGGBB/0.7 a base hue at an opacity step; empty = chart.empty; null = none.",
    "expected": "Only the keys present are compared. dataLabels use side positive/negative for stack totals."
  },
  "defaults": {
    "chartType": 0,
    "aggregation": 0,
    "groupStyle": "stacked",
    "cumulative": false,
    "showEmptyValues": true,
    "hiddenGroups": [],
    "xSort": "auto",
    "colorTheme": "auto",
    "legendPosition": "auto",
    "showDataLabels": true,
    "limits": { "maxCategories": 200, "maxSeries": 50 }
  },
  "groupedBarWidth": [
    { "slot": 100, "seriesCount": 3, "width": 16 },
    { "slot": 60, "seriesCount": 2, "width": 16 },
    { "slot": 40, "seriesCount": 3, "width": 10.666666666666666 },
    { "slot": 30, "seriesCount": 4, "width": 6 },
    { "slot": 10, "seriesCount": 50, "width": 1 }
  ],
