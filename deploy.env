APPFLOWY_BASE_URL=http://localhost
APPFLOWY_GOTRUE_BASE_URL=http://localhost/gotrue
APPFLOWY_WS_BASE_URL=ws://localhost/ws/v2
# Optional override: public origin of the AppFlowy MCP service, without /mcp (e.g. https://mcp.example.com).
# Leave empty to use the mcp_url AppFlowy Cloud advertises in /api/server-info; AI app connections
# (Settings > AI apps, /oauth/mcp/*) stay hidden when neither is set. Cloud advertises mcp_url only
# while AI apps are turned on, so set this wherever the MCP service runs: Settings > AI apps then
# still says when they are off and lets members disconnect their apps. See doc/MCP.md.
APPFLOWY_MCP_BASE_URL=
# Published page SSR — off by default. See doc/PUBLISH_SSR.md.
# APPFLOWY_INDEXABLE_NAMESPACES=docs,guide
# APPFLOWY_SSR_KILL_SWITCH=false
# APPFLOWY_SSR_SNAPSHOT_TIMEOUT_MS=1500
# APPFLOWY_SSR_MAX_INLINE_BYTES=1048576
