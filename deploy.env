APPFLOWY_BASE_URL=http://localhost
APPFLOWY_GOTRUE_BASE_URL=http://localhost/gotrue
APPFLOWY_WS_BASE_URL=ws://localhost/ws/v2
# Optional override: public origin of the AppFlowy MCP service, without /mcp. The bundled
# deployments serve it on the AppFlowy domain (e.g. https://appflowy.example.com); a separate origin
# also works when its CORS and APPFLOWY_WEB_URL name this Web.
# Leave empty to use the mcp_url AppFlowy Cloud advertises in /api/server-info. When neither is
# set, Settings hides the MCP tab and /oauth/mcp/* say AI app connections are not configured.
# Cloud advertises mcp_url only while AI apps are turned on, so set this wherever the MCP service
# runs: Settings → MCP then still says when they are off and lets members disconnect their apps.
# Keep it equal to AppFlowy Cloud's APPFLOWY_MCP_BASE_URL: it wins over server-info, and the
# browser console warns when Cloud advertises a different origin. See doc/MCP.md.
APPFLOWY_MCP_BASE_URL=
# Published page SSR — off by default. See doc/PUBLISH_SSR.md.
# APPFLOWY_INDEXABLE_NAMESPACES=docs,guide
# APPFLOWY_SSR_KILL_SWITCH=false
# APPFLOWY_SSR_SNAPSHOT_TIMEOUT_MS=1500
# APPFLOWY_SSR_MAX_INLINE_BYTES=1048576
