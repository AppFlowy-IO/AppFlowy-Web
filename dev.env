APPFLOWY_BASE_URL=http://localhost:8000
APPFLOWY_GOTRUE_BASE_URL=http://localhost:9999
APPFLOWY_WS_BASE_URL=ws://localhost:8000/ws/v2
# Optional override of the AppFlowy MCP service origin (without /mcp). Unset: the Web uses the
# mcp_url AppFlowy Cloud advertises in /api/server-info. See doc/MCP.md.
APPFLOWY_MCP_BASE_URL=http://localhost:8002
# Published page SSR (Bun server in deploy/ only; not used by `pnpm run dev`).
# Off by default. See doc/PUBLISH_SSR.md.
# APPFLOWY_INDEXABLE_NAMESPACES=docs,guide
# APPFLOWY_SSR_KILL_SWITCH=false
# APPFLOWY_SSR_SNAPSHOT_TIMEOUT_MS=1500
# APPFLOWY_SSR_MAX_INLINE_BYTES=1048576
